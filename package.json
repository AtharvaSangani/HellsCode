{
  "name": "coderoast",
  "displayName": "CodeRoast",
  "publisher": "yourname",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onCommand:coderoast.hell"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.5.7",
    "typescript": "^5.2.2",
    "vscode": "^1.1.37"
  },
  "contributes": {
    "commands": [
      {
        "command": "coderoast.hell",
        "title": "💀 Enter Hell Mode"
      }
    ]
  },
  "dependencies": {
    "say": "^0.16.0"
  }
}
